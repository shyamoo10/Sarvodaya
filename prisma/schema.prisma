// Prisma schema for the Sarvodaya hardware shop API.
// Money is always stored as integer paise (see the order models added in later steps).
// Everything the shop owner may change (prices, charges, slabs, pincodes) belongs
// in data tables driven by admin APIs, never in code.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountType {
  CUSTOMER
  CONTRACTOR
  ADMIN
}

model User {
  id          String      @id @default(uuid()) @db.Uuid
  phone       String      @unique @db.VarChar(10)
  name        String      @db.VarChar(120)
  accountType AccountType @default(CUSTOMER)

  /// Optional for every account type. Never required to place an order.
  companyName String? @db.VarChar(160)
  gstNumber   String? @db.VarChar(15)

  /// Admin block flag: when true the account cannot log in and existing tokens stop working.
  isBlocked     Boolean   @default(false)
  blockedAt     DateTime?
  blockedReason String?   @db.VarChar(200)

  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  addresses    Address[]
  projectSites ProjectSite[]

  /// Contractors only: negotiated per-product prices.
  contractorPrices ContractorPrice[] @relation("ContractorPrices")
  cart             Cart?

  /// Orders placed by this account.
  orders        Order[]              @relation("UserOrders")
  creditTerms   CreditTerms?         @relation("ContractorCredit")
  orderChanges  OrderStatusHistory[] @relation("OrderStatusChanges")
  recordedPayments Payment[]         @relation("RecordedPayments")

  /// Step 5: order notifications, push tokens and the admin audit trail.
  notifications Notification[] @relation("UserNotifications")
  deviceTokens  DeviceToken[]
  auditLogs     AuditLog[]

  @@index([accountType])
  @@index([isBlocked])
}

/// Saved delivery address (home, shop, site office...).
model Address {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  label        String? @db.VarChar(40)
  contactName  String  @db.VarChar(120)
  contactPhone String  @db.VarChar(10)

  line1    String  @db.VarChar(200)
  line2    String? @db.VarChar(200)
  landmark String? @db.VarChar(160)
  city     String  @db.VarChar(80)
  state    String  @db.VarChar(80)
  pincode  String  @db.VarChar(6)

  latitude  Float?
  longitude Float?

  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  carts Cart[]

  /// Orders delivered to this address. Orders keep their own copy of the address,
  /// so editing or deleting it later never changes an old order.
  orders Order[] @relation("OrderDeliveryAddress")

  @@index([userId])
}

/// Contractor project site. Customers may use it too (e.g. building a house).
model ProjectSite {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  siteName     String  @db.VarChar(120)
  contactName  String? @db.VarChar(120)
  contactPhone String? @db.VarChar(10)

  line1    String  @db.VarChar(200)
  line2    String? @db.VarChar(200)
  landmark String? @db.VarChar(160)
  city     String  @db.VarChar(80)
  state    String  @db.VarChar(80)
  pincode  String  @db.VarChar(6)

  latitude  Float?
  longitude Float?
  notes     String? @db.VarChar(500)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

enum ProductUnit {
  KG
  BAG
  PIECE
  LITRE
  BOX
}

/// Categories and sub-categories. `parentId` is null for a top-level category.
/// Only two levels are supported, so a category with a parent cannot have children.
model Category {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @db.VarChar(80)
  slug        String  @unique @db.VarChar(90)
  description String? @db.VarChar(300)

  parentId String?    @db.Uuid
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryTree")

  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  products        Product[]
  bulkDiscounts   BulkDiscount[]
  contractorRules ContractorRule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
}

/// A sellable item. Prices are integer paise; everything the shop owner may
/// change (price, stock, visibility) is editable through admin APIs.
model Product {
  id          String  @id @default(uuid()) @db.Uuid
  sku         String  @unique @db.VarChar(40)
  name        String  @db.VarChar(160)
  description String? @db.VarChar(1000)
  brand       String  @db.VarChar(80)

  /// Size / variant label, for example "12 mm" or "20 L pack".
  sizeVariant String?     @db.VarChar(80)
  unit        ProductUnit

  pricePaise    Int
  stockQuantity Int      @default(0)
  photos        String[] @default([])

  categoryId String   @db.Uuid
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  /// Hidden products stay in the database but disappear from the public API.
  isActive Boolean @default(true)

  contractorPrices ContractorPrice[]
  bulkDiscounts    BulkDiscount[]
  cartItems        CartItem[]
  orderItems       OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([brand])
  @@index([pricePaise])
  @@index([isActive])
}

/// Shop-wide pricing and delivery settings. A single row, id "default", edited by
/// the admin: nothing here is hard-coded in the API.
model ShopSettings {
  id            String @id @default("default") @db.VarChar(20)
  shopLatitude  Float
  shopLongitude Float

  /// Orders below this amount pay a small order charge.
  minOrderAmountPaise Int @default(0)
  minOrderChargePaise Int @default(0)

  /// Free delivery when the item total reaches this amount, or when the delivery
  /// distance is within this radius. Null switches that rule off.
  freeDeliveryAbovePaise Int?
  freeDeliveryRadiusKm   Float?

  updatedAt DateTime @updatedAt
}

/// Distance-based delivery charge, measured from the shop location.
/// `fromKm` is inclusive, `toKm` exclusive; a null `toKm` means "and beyond".
model DistanceSlab {
  id          String  @id @default(uuid()) @db.Uuid
  fromKm      Float
  toKm        Float?
  chargePaise Int
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fromKm])
}

/// Pincodes the shop delivers to. Coordinates act as the area centre when a
/// customer's address carries no latitude/longitude of its own.
model ServiceablePincode {
  pincode   String  @id @db.VarChar(6)
  areaName  String? @db.VarChar(120)
  city      String? @db.VarChar(80)
  latitude  Float
  longitude Float
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

/// A negotiated price for one contractor and one product. Wins over every other
/// pricing rule.
model ContractorPrice {
  id           String @id @default(uuid()) @db.Uuid
  contractorId String @db.Uuid
  contractor   User   @relation("ContractorPrices", fields: [contractorId], references: [id], onDelete: Cascade)

  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  pricePaise Int
  isActive   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([contractorId, productId])
  @@index([productId])
}

/// Quantity discount. Scope is a product, a category (including its
/// sub-categories) or the whole shop when both ids are null.
model BulkDiscount {
  id   String @id @default(uuid()) @db.Uuid
  name String @unique @db.VarChar(80)

  productId  String?   @db.Uuid
  product    Product?  @relation(fields: [productId], references: [id], onDelete: Cascade)
  categoryId String?   @db.Uuid
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  minQuantity Int
  /// Percentage in basis points: 250 = 2.50%.
  discountBps Int
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([categoryId])
}

/// Percentage discount for contractor accounts, optionally limited to one
/// category (its sub-categories included).
model ContractorRule {
  id   String @id @default(uuid()) @db.Uuid
  name String @unique @db.VarChar(80)

  categoryId String?   @db.Uuid
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  /// Percentage in basis points: 500 = 5%.
  discountBps Int
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
}

/// One server-side cart per account, so it survives app restarts and reinstalls.
/// Prices are never stored: lines are priced on every read.
model Cart {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  deliveryAddressId String?  @db.Uuid
  deliveryAddress   Address? @relation(fields: [deliveryAddressId], references: [id], onDelete: SetNull)

  items CartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CartItem {
  id     String @id @default(uuid()) @db.Uuid
  cartId String @db.Uuid
  cart   Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)

  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  quantity Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, productId])
  @@index([productId])
}

// ---------------------------------------------------------------------------
// Step 4: orders, payments and contractor credit
// ---------------------------------------------------------------------------

enum OrderStatus {
  CONFIRMED
  PACKED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  ONLINE
  CASH_ON_DELIVERY
  CREDIT
}

/// Payment state of the order as a whole, derived from its successful payments.
enum PaymentStatus {
  PENDING
  PARTIALLY_PAID
  PAID
}

/// State of one payment attempt or receipt.
enum PaymentRecordStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum PaymentProvider {
  RAZORPAY
  CASH
  CREDIT
}

/// Monotonic counters used for human-friendly numbers such as order numbers.
model Counter {
  id    String @id @db.VarChar(20)
  value Int    @default(0)
}

/// A placed order. Prices are copied onto the order and its lines at the time of
/// sale, so later price or rule changes never rewrite what the customer bought.
model Order {
  id          String @id @default(uuid()) @db.Uuid
  orderNumber String @unique @db.VarChar(20)

  userId String @db.Uuid
  user   User   @relation("UserOrders", fields: [userId], references: [id], onDelete: Restrict)

  status OrderStatus @default(CONFIRMED)

  paymentMethod PaymentMethod @default(CASH_ON_DELIVERY)
  paymentStatus PaymentStatus @default(PENDING)
  /// Sum of the payments that succeeded so far.
  amountPaidPaise Int @default(0)

  // Money snapshot, in paise.
  itemTotalPaise      Int
  minOrderChargePaise Int @default(0)
  distanceChargePaise Int @default(0)
  grandTotalPaise     Int
  currency            String @default("INR") @db.VarChar(3)

  /// A charge the admin waived on this single order (never on the shop settings).
  waivedChargeCode String? @db.VarChar(30)
  waivedChargePaise Int    @default(0)
  waivedChargeNote String? @db.VarChar(200)

  // Delivery address copied at checkout, so the order keeps the address it was sent to.
  deliveryAddressId    String?  @db.Uuid
  deliveryAddress      Address? @relation("OrderDeliveryAddress", fields: [deliveryAddressId], references: [id], onDelete: SetNull)
  deliveryContactName  String   @db.VarChar(120)
  deliveryContactPhone String   @db.VarChar(10)
  deliveryLine1        String   @db.VarChar(200)
  deliveryLine2        String?  @db.VarChar(200)
  deliveryLandmark     String?  @db.VarChar(160)
  deliveryCity         String   @db.VarChar(80)
  deliveryState        String   @db.VarChar(80)
  deliveryPincode      String   @db.VarChar(6)
  distanceKm           Float?

  /// Requested delivery day and slot. The shop confirms the exact timing.
  deliveryDate DateTime? @db.Date
  deliverySlot String?   @db.VarChar(60)
  notes        String?   @db.VarChar(500)

  /// Set by the client on checkout; a repeat with the same key returns this order.
  idempotencyKey String? @db.VarChar(128)

  placedAt     DateTime  @default(now())
  cancelledAt  DateTime?
  cancelReason String?   @db.VarChar(200)

  items         OrderItem[]
  statusHistory OrderStatusHistory[]
  payments      Payment[]
  notifications Notification[]
  invoice       Invoice?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@unique([userId, idempotencyKey])
  @@index([userId, placedAt])
  @@index([status])
  @@index([paymentStatus])
  @@index([placedAt])
}

/// One line of an order, with the product details and price frozen at the time of sale.
model OrderItem {
  id      String @id @default(uuid()) @db.Uuid
  orderId String @db.Uuid
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String?  @db.Uuid
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  sku         String      @db.VarChar(40)
  name        String      @db.VarChar(160)
  brand       String      @db.VarChar(80)
  sizeVariant String?     @db.VarChar(80)
  unit        ProductUnit
  photos      String[]    @default([])

  quantity          Int
  originalPricePaise Int
  unitPricePaise     Int
  lineTotalPaise     Int

  appliedRuleType  String  @db.VarChar(40)
  appliedRuleId    String? @db.Uuid
  appliedRuleLabel String  @db.VarChar(120)

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([productId])
}

/// Append-only history of order status changes, written on every transition.
model OrderStatusHistory {
  id      String @id @default(uuid()) @db.Uuid
  orderId String @db.Uuid
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  fromStatus OrderStatus?
  toStatus   OrderStatus
  note       String?       @db.VarChar(300)

  changedById String? @db.Uuid
  changedBy   User?   @relation("OrderStatusChanges", fields: [changedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
}

/// One payment attempt or receipt for an order. Online payments start PENDING and
/// only become SUCCEEDED after a verified Razorpay signature or webhook.
model Payment {
  id      String @id @default(uuid()) @db.Uuid
  orderId String @db.Uuid
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  provider PaymentProvider
  status   PaymentRecordStatus @default(PENDING)

  amountPaise Int

  /// Razorpay identifiers. The signature flag records that the server verified them.
  providerOrderId            String? @db.VarChar(80)
  providerPaymentId          String? @db.VarChar(80) @unique
  razorpaySignatureVerified  Boolean @default(false)

  note      String?   @db.VarChar(200)
  receivedAt DateTime?

  recordedById String? @db.Uuid
  recordedBy   User?   @relation("RecordedPayments", fields: [recordedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([providerOrderId])
}

/// Pay-later terms the admin gives a contractor. Checkout with CREDIT is only
/// allowed while this exists and is enabled, and stays within the credit limit.
model CreditTerms {
  id           String @id @default(uuid()) @db.Uuid
  contractorId String @unique @db.Uuid
  contractor   User   @relation("ContractorCredit", fields: [contractorId], references: [id], onDelete: Cascade)

  isEnabled       Boolean @default(true)
  /// Null means no hard limit; the shop still sees the outstanding balance.
  creditLimitPaise Int?
  paymentTermDays  Int    @default(30)
  notes            String? @db.VarChar(300)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isEnabled])
}

// ---------------------------------------------------------------------------
// Step 5: admin dashboard, notifications, invoices, reports and audit log
// ---------------------------------------------------------------------------

enum NotificationChannel {
  PUSH
  SMS
  WHATSAPP
}

/// The customer-facing moments of an order. CONFIRMED is sent when the shop
/// starts packing (CONFIRMED -> PACKED), DISPATCHED when the order leaves
/// (OUT_FOR_DELIVERY) and DELIVERED when it reaches the buyer.
enum NotificationEvent {
  ORDER_PLACED
  ORDER_CONFIRMED
  ORDER_DISPATCHED
  ORDER_DELIVERED
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum DevicePlatform {
  ANDROID
  IOS
  WEB
}

/// One queued notification. The row itself is the queue: a background worker
/// picks up due rows, sends them and retries a few times before giving up, so a
/// failed push or SMS never blocks an order.
model Notification {
  id      String  @id @default(uuid()) @db.Uuid
  userId  String  @db.Uuid
  user    User    @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  orderId String? @db.Uuid
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  event   NotificationEvent
  channel NotificationChannel
  status  NotificationStatus  @default(PENDING)

  title String @db.VarChar(160)
  body  String @db.VarChar(600)

  attempts      Int       @default(0)
  maxAttempts   Int       @default(5)
  nextAttemptAt DateTime  @default(now())
  lastError     String?   @db.VarChar(500)
  sentAt        DateTime?
  providerMessageId String? @db.VarChar(80)

  /// Stops the same event and channel being queued twice for one order.
  dedupeKey String? @unique @db.VarChar(120)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, nextAttemptAt])
  @@index([userId, createdAt])
  @@index([orderId])
}

/// Push registration token for one device of one account.
model DeviceToken {
  id       String @id @default(uuid()) @db.Uuid
  userId   String @db.Uuid
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  token    String         @unique @db.VarChar(300)
  platform DevicePlatform @default(ANDROID)
  isActive Boolean        @default(true)

  lastSeenAt DateTime  @default(now())
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId])
}

enum InvoiceKind {
  /// The buyer gave a GST number at checkout.
  TAX_INVOICE
  /// A normal bill for a buyer without a GST number.
  BILL
}

/// One invoice per order, numbered from the invoice counter and created in the
/// same transaction as the order. Amounts are the order's frozen totals; taxes
/// are not invented here, the shop's accountant can add them outside the API.
model Invoice {
  id            String @id @default(uuid()) @db.Uuid
  orderId       String @unique @db.Uuid
  order         Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  invoiceNumber String      @unique @db.VarChar(24)
  kind          InvoiceKind
  buyerGstNumber  String? @db.VarChar(15)
  sellerGstNumber String? @db.VarChar(15)

  itemTotalPaise  Int
  chargesPaise    Int
  grandTotalPaise Int
  currency        String @default("INR") @db.VarChar(3)

  issuedAt  DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([issuedAt])
}

/// Append-only record of every admin change: who did what, to which record.
model AuditLog {
  id String @id @default(uuid()) @db.Uuid

  actorId   String? @db.Uuid
  actor     User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorName String? @db.VarChar(120)
  actorPhone String? @db.VarChar(10)

  /// Stable action name such as "ADMIN_PRODUCT_UPDATE".
  action     String  @db.VarChar(60)
  entityType String  @db.VarChar(40)
  entityId   String? @db.VarChar(64)

  summary  String? @db.VarChar(300)
  metadata Json?

  ipAddress String? @db.VarChar(64)
  requestId String? @db.VarChar(64)

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([actorId])
}
