# ---------------------------------------------------------------------------
# Sarvodaya API - example environment file.
# Copy to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------

# App
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Database (PostgreSQL)
DATABASE_URL=postgresql://sarvodaya:sarvodaya@localhost:5432/sarvodaya?schema=public

# Redis (used for OTP storage and rate limiting)
REDIS_URL=redis://localhost:6379

# Auth - generate with: openssl rand -hex 32
# JWT_SECRET and OTP_HASH_SECRET must be at least 32 characters and must be
# different values in every environment.
JWT_SECRET=change-me-to-a-long-random-string-min-32-chars
JWT_EXPIRES_IN=30d
OTP_HASH_SECRET=change-me-to-another-long-random-string-min-32-chars

# CORS: comma separated list of allowed frontend origins, or * for any.
CORS_ORIGINS=http://localhost:5173,http://localhost:8081

# OTP behaviour
OTP_TTL_SECONDS=300
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_REQUESTS_PER_WINDOW=5
OTP_WINDOW_SECONDS=3600
OTP_REQUESTS_PER_IP_PER_WINDOW=30

# Development-only fixed OTP. Ignored completely when NODE_ENV=production.
DEV_FIXED_OTP=123456
DEV_FIXED_OTP_ENABLED=true

# Seed script (admin account is only ever created by the seed script)
SEED_ADMIN_PHONE=9999999999
SEED_ADMIN_NAME=Sarvodaya Admin
SEED_ADMIN_COMPANY=Sarvodaya Hardware
SEED_SAMPLE_USERS=true
SEED_SAMPLE_PRODUCTS=true
# Pricing, delivery slabs and serviceable pincodes (idempotent, never overwrites)
SEED_PRICING=true
# Sample pay-later terms for the seed contractor (idempotent)
SEED_CREDIT_TERMS=true

# Razorpay (online payment). Leave empty to offer only cash on delivery and credit.
# The key id is public and sent to the app; the secret and the webhook secret never leave
# the server. The webhook secret is the one you set in the Razorpay dashboard.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_BASE_URL=https://api.razorpay.com

# Notifications (Step 5). Messages are queued in the database and sent by the
# background worker with retries; the API keeps working if a provider is down.
NOTIFICATIONS_ENABLED=true
# Any of PUSH, SMS, WHATSAPP (comma separated).
NOTIFICATION_CHANNELS=PUSH,SMS
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_RETRY_BASE_SECONDS=60
NOTIFICATION_POLL_INTERVAL_MS=15000
# Optional provider keys. Without a key the channel is logged instead of sent, so
# development never messages a real customer.
PUSH_PROVIDER_KEY=
SMS_PROVIDER_KEY=
WHATSAPP_PROVIDER_KEY=
WHATSAPP_SENDER_NUMBER=

# Invoices (Step 5). The seller GSTIN is printed only when it is set; the buyer's
# GSTIN only when the buyer gave one, otherwise the invoice is a plain bill.
SHOP_NAME=Sarvodaya Hardware
SHOP_ADDRESS=
SHOP_PHONE=
SHOP_GST_NUMBER=
INVOICE_PREFIX=SAR-INV
